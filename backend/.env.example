# =========================================================================
# DATABASE & SERVER CONFIGURATIONS
# =========================================================================
MONGO_URI=your_mongodb_connection_uri
PORT=3000

# =========================================================================
# JWT AUTHENTICATION CONFIGURATIONS
# =========================================================================
jwt_secret=your_legacy_jwt_secret
ACCESS_TOKEN_SECRET=your_access_token_signing_secret
REFRESH_TOKEN_SECRET=your_refresh_token_signing_secret
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# =========================================================================
# NODEMAILER / GMAIL OAUTH2 CONFIGURATIONS
# =========================================================================
CLIENT_ID=your_gmail_oauth2_client_id
CLIENT_SECRET=your_gmail_oauth2_client_secret
REFRESH_TOKEN=your_gmail_oauth2_refresh_token
EMAIL_USER=your_sender_gmail_address

# =========================================================================
# SYSTEM/ADMIN USER SEED CONFIGURATIONS
# =========================================================================
SYSTEM_NAME=Bank System
SYSTEM_EMAIL=system@bank.com
SYSTEM_PASSWORD=your_secure_system_password
